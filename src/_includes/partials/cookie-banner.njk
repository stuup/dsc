<section data-cookie-banner hidden aria-labelledby="cookie-banner-title"
         class="fixed inset-x-0 bottom-0 z-50 bg-charcoal/95 py-5 text-white shadow-[0_-2px_12px_rgba(0,0,0,0.25)]">
  <div class="container-site flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 id="cookie-banner-title" class="text-[15px] leading-6 text-white">Cookies</h2>
      <p class="mt-1 max-w-[720px]">We'd like to use Google Analytics cookies to understand how people use this site so we can improve it. They're only set if you accept. <a href="/privacy/#cookies" class="underline hover:text-brand">Read more</a></p>
    </div>
    <div class="flex shrink-0 gap-3">
      <button type="button" data-cookie-choice="granted" class="btn">Accept</button>
      <button type="button" data-cookie-choice="denied" class="btn btn-ghost">Reject</button>
    </div>
  </div>
</section>
