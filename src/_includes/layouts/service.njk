---
layout: layouts/base.njk
---
{% from "macros.njk" import pageHeader %}
{{ pageHeader(title, [{ label: "Services", url: "/services/" }, { label: title }]) }}

<div class="container-site py-[70px]">
  {%- if images %}
  <div class="grid gap-[30px] md:grid-cols-2">
    {%- for img in images %}
    <img src="{{ img.src }}"
         {% if img.src2x %}srcset="{{ img.src }} 480w, {{ img.src2x }} 750w" sizes="(min-width: 1170px) 570px, (min-width: 768px) 50vw, 100vw"{% endif %}
         alt="{{ title }} work by {{ site.name }}" width="480" height="320" {% if not loop.first %}loading="lazy"{% endif %} decoding="async"
         class="aspect-[3/2] w-full border border-line object-cover">
    {%- endfor %}
  </div>
  {%- endif %}

  <h2 class="box-header mt-[50px] text-[22px] leading-[34px] uppercase">Service Overview</h2>
  <div class="content mt-6 max-w-4xl">
    {{ content | safe }}
  </div>

  <hr class="my-10 h-px border-0 bg-linear-to-r from-transparent via-black/60 to-transparent">

  <h3 class="box-header text-[22px] leading-[34px] uppercase">Services Covered</h3>
  <ul class="mt-6 grid gap-x-[30px] gap-y-2 sm:grid-cols-2 lg:grid-cols-3">
    {%- for item in covered %}
    <li class="flex items-start gap-3">
      <span class="mt-1 text-brand">{% icon "chevron-right", "size-4", 2.5 %}</span>
      <span>{{ item }}</span>
    </li>
    {%- endfor %}
  </ul>

  {%- if gallery and gallery.length %}
  <h3 class="box-header mt-[70px] text-[22px] leading-[34px] uppercase">Our Work</h3>
  <ul class="mt-8 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4 lg:gap-[10px]" data-gallery>
    {%- for img in gallery %}
    <li>
      <a href="{{ img.full }}" class="group block overflow-hidden bg-mist" data-lightbox>
        <img src="{{ img.thumb }}" alt="{{ title }} project photo {{ loop.index }}" width="600" height="400" loading="lazy" decoding="async"
             class="aspect-[3/2] w-full object-cover transition duration-300 group-hover:scale-105 group-hover:opacity-80">
      </a>
    </li>
    {%- endfor %}
  </ul>
  {%- endif %}

  <div class="mt-[70px] flex flex-col items-center gap-6 bg-mist px-6 py-12 text-center">
    <h3 class="text-[22px] leading-[34px] uppercase">Planning a {{ title | lower }} project?</h3>
    <p class="max-w-2xl text-base leading-[26px]">Call us on <a href="{{ site.phone | telHref }}" class="font-semibold text-brand-dark hover:underline">{{ site.phone }}</a> or email <a href="mailto:{{ site.email }}" class="font-semibold text-brand-dark hover:underline">{{ site.email }}</a> for a free, no-obligation quote.</p>
    <a href="/contact/" class="btn">Get in touch</a>
  </div>
</div>

<dialog data-lightbox-dialog aria-label="Image viewer"
        class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/90">
  <figure class="relative flex h-dvh w-screen items-center justify-center p-4 sm:p-12">
    <img data-lightbox-img src="" alt="" class="max-h-full max-w-full object-contain shadow-2xl">
    <figcaption data-lightbox-count class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-white/80"></figcaption>
  </figure>
  <button type="button" data-lightbox-close class="absolute top-3 right-3 flex size-11 items-center justify-center rounded-full text-white hover:bg-white/10" aria-label="Close">{% icon "x", "size-7", 2 %}</button>
  <button type="button" data-lightbox-prev class="absolute top-1/2 left-2 flex size-12 -translate-y-1/2 items-center justify-center rounded-full text-white hover:bg-white/10" aria-label="Previous image">{% icon "chevron-left", "size-8", 2 %}</button>
  <button type="button" data-lightbox-next class="absolute top-1/2 right-2 flex size-12 -translate-y-1/2 items-center justify-center rounded-full text-white hover:bg-white/10" aria-label="Next image">{% icon "chevron-right", "size-8", 2 %}</button>
</dialog>
