{
  "name": "dsc-complete-building-solutions",
  "version": "1.0.0",
  "private": true,
  "description": "DSC Complete Building Solutions website — Eleventy + Tailwind CSS, deployed on Netlify",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:css": "tailwindcss -i src/assets/css/main.css -o _site/assets/css/main.css --watch",
    "dev:site": "eleventy --serve --quiet",
    "build": "npm run build:site && npm run build:css",
    "build:site": "eleventy",
    "build:css": "tailwindcss -i src/assets/css/main.css -o _site/assets/css/main.css --minify",
    "clean": "rm -rf _site"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource-variable/raleway": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "lucide-static": "^1.48.0",
    "npm-run-all2": "^9.0.3",
    "tailwindcss": "^4.3.3"
  }
}
